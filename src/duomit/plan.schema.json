{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "duomit reference plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "capability",
          "depends_on",
          "requires_approval"
        ],
        "properties": {
          "step_id": {
            "$ref": "#/$defs/identifier"
          },
          "capability": {
            "$ref": "#/$defs/identifier"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "requires_approval": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    }
  }
}
